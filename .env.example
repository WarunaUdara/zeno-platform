# Encrypts ticket QR credentials at rest (exactly 32 bytes, base64url).
# Generate one with:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip('='))"
# Losing or rotating this makes existing ticket QR codes unreadable. Store it in a
# secret manager for any deployed environment, never in this file.
ZENO_TICKET_CREDENTIAL_KEY=
