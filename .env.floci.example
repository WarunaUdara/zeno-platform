# Local GCP Emulation with Floci (Zero Cloud Spend, Port 4588)
# Source this file or eval $(floci gcp env) to route GCP SDKs to localhost

CLOUDSDK_CORE_PROJECT=floci-local
CLOUDSDK_AUTH_ACCESS_TOKEN=floci

# Storage emulator
STORAGE_EMULATOR_HOST=http://localhost:4588
CLOUDSDK_API_ENDPOINT_OVERRIDES_STORAGE=http://localhost:4588/storage/v1/

# Secret Manager emulator
SECRET_MANAGER_EMULATOR_HOST=localhost:4588
CLOUDSDK_API_ENDPOINT_OVERRIDES_SECRETMANAGER=http://localhost:4588/

# Pub/Sub emulator (if enabled)
PUBSUB_EMULATOR_HOST=localhost:4588

# Cloud Run emulator
CLOUDSDK_API_ENDPOINT_OVERRIDES_RUN=http://localhost:4588/
